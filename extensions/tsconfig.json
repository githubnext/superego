// What every extension's tsconfig.json extends: `{ "extends": "../tsconfig.json", "include": ["src", "test"] }`. Its
// halves are checked as the window and the daemon build them (React, the DOM, Node, a bundler's imports of CSS).
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": { "types": ["node"], "jsx": "react-jsx", "lib": ["es2023", "dom"], "module": "esnext", "moduleResolution": "bundler" },
  "files": ["./css.d.ts"]
}

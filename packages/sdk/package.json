{
  "name": "@superego/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What an extension's author imports: 'superego', 'superego/ui', 'superego/testing', and 'superego/unstable'",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./unstable": "./src/unstable.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json",
    "./vitest.author": "./vitest.author.ts",
    "./types": "./types.ts"
  },
  "dependencies": {
    "@superego/app": "workspace:*",
    "@superego/client": "workspace:*",
    "@superego/daemon": "workspace:*",
    "@superego/protocol": "workspace:*",
    "happy-dom": "^21.0.4"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "rollup": "^4.68.0",
    "rollup-plugin-dts": "^6.5.1"
  }
}

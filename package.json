{
  "name": "superego",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "node scripts/check.ts tsc -b",
    "test": "node scripts/check.ts vitest run",
    "dev": "pnpm --filter superego dev",
    "build": "pnpm --filter superego build",
    "link:cli": "ln -sf \"$PWD/app/bin/superego.ts\" \"$HOME/.local/bin/superego\" && echo \"Linked $HOME/.local/bin/superego\"",
    "smoke": "pnpm --filter superego smoke",
    "bundle": "pnpm --filter superego bundle",
    "release": "pnpm --filter superego release",
    "eval": "node evals/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "happy-dom": "^21.0.4",
    "typescript": "^7",
    "vitest": "^5"
  }
}

{
  "name": "mu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "tsc -p packages/protocol && tsc -p packages/settings && tsc -p packages/daemon && tsc -p packages/ui && tsc -p app",
    "test": "vitest run",
    "dev": "pnpm --filter @mu/app dev",
    "build": "pnpm --filter @mu/app build",
    "daemon": "node packages/daemon/src/cli.ts daemon"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^6",
    "vitest": "^5"
  }
}

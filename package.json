{
  "name": "mu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "tsc -p packages/protocol && tsc -p packages/settings && tsc -p packages/daemon && tsc -p packages/client && tsc -p packages/cli && tsc -p packages/ui && tsc -p app",
    "test": "vitest run",
    "dev": "pnpm --filter @mu/app dev",
    "build": "pnpm --filter @mu/app build",
    "link:cli": "ln -sf \"$PWD/app/bin/mu.ts\" \"$HOME/.local/bin/mu\" && echo \"Linked $HOME/.local/bin/mu\""
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^6",
    "vitest": "^5"
  }
}